diff --git a/assets/css/custom.css b/assets/css/custom.css
index 85b87a3..ad9031b 100644
--- a/assets/css/custom.css
+++ b/assets/css/custom.css
@@ -2359,3 +2359,93 @@ html {
   .ep-matriculas__grade { grid-template-columns: 1fr; }
   .ep-matriculas__foto { max-width: 320px; }
 }
+
+/* ---------------------------------------------------------------
+   PASSOS DA MATRÍCULA — três passos numerados, ligados por uma
+   linha tracejada. Conteúdo em data/passos_matricula.yaml.
+   --------------------------------------------------------------- */
+
+.prose ol.ep-passos,
+ol.ep-passos {
+  list-style: none;
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 1.5rem;
+  margin: 2.25rem 0 2.5rem;
+  padding: 0;
+  scroll-margin-top: 1.5rem;
+}
+
+.prose ol.ep-passos > li.ep-passo,
+.ep-passo {
+  position: relative;
+  margin: 0;
+  padding: 0;
+}
+
+.prose ol.ep-passos > li.ep-passo::marker { content: none; }
+
+/* linha tracejada entre um número e o próximo */
+.ep-passo:not(:last-child)::after {
+  content: "";
+  position: absolute;
+  top: 1.6rem;
+  left: 4rem;
+  right: -0.9rem;
+  border-top: 2px dashed var(--ep-terracota);
+  opacity: 0.55;
+}
+
+.ep-passo__numero {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 3.25rem;
+  height: 3.25rem;
+  border-radius: 52% 48% 50% 50% / 48% 52% 48% 52%;
+  background: var(--ep-terracota);
+  color: var(--ep-creme-claro);
+  font-family: "Fraunces", Georgia, serif;
+  font-weight: 700;
+  font-size: 1.5rem;
+  line-height: 1;
+}
+
+.prose .ep-passo__titulo,
+.ep-passo__titulo {
+  font-size: 1.15rem;
+  line-height: 1.25;
+  color: var(--ep-tinta);
+  margin: 0.9rem 0 0.35rem;
+}
+
+.prose .ep-passo__texto,
+.ep-passo__texto {
+  font-size: 0.95rem;
+  line-height: 1.55;
+  color: var(--ep-tinta-corpo);
+  margin: 0;
+}
+
+@media (max-width: 640px) {
+  .prose ol.ep-passos,
+  ol.ep-passos { grid-template-columns: 1fr; gap: 1.4rem; }
+
+  .prose ol.ep-passos > li.ep-passo,
+  .ep-passo { padding-left: 4.25rem; min-height: 3.25rem; }
+
+  .ep-passo__numero { position: absolute; left: 0; top: 0; }
+
+  .prose .ep-passo__titulo,
+  .ep-passo__titulo { margin-top: 0; padding-top: 0.2rem; }
+
+  /* no celular a linha desce de um número ao outro */
+  .ep-passo:not(:last-child)::after {
+    top: 3.6rem;
+    bottom: -1.1rem;
+    left: 1.6rem;
+    right: auto;
+    border-top: 0;
+    border-left: 2px dashed var(--ep-terracota);
+  }
+}
